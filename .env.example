# 複製成 .env 後填入（.env 不進版控）
# 模擬器機器人帳號（sim_ 開頭）的密碼：第一次跑模擬器時會用這個密碼自動註冊
SIM_BOT_PASSWORD=請自己設定
# 管理後台可以看的帳號（逗號分隔），docker compose 會傳給 api
ADMIN_USERS=wei
# 之後串 Telegram 推播時才需要
# TELEGRAM_BOT_TOKEN=
# Web Push 推播金鑰（VAPID）。產生：cd backend && uv run --with cryptography python -m tools.gen_vapid；沒填的話網頁上的「開啟通知」會顯示未設定
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
