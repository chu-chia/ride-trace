# 複製成 .env 後填入（.env 不進版控）
# 模擬器機器人帳號（sim_ 開頭）的密碼：第一次跑模擬器時會用這個密碼自動註冊
SIM_BOT_PASSWORD=請自己設定
# 管理後台可以看的帳號（逗號分隔），docker compose 會傳給 api
ADMIN_USERS=wei
# 之後串 Telegram 推播時才需要
# TELEGRAM_BOT_TOKEN=
# Web Push 推播金鑰（VAPID）。產生：cd backend && uv run --with cryptography python -m tools.gen_vapid；沒填的話網頁上的「開啟通知」會顯示未設定
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# 交通部 TDX（tdx.transportdata.tw 會員中心 → 資料服務 → API 金鑰）：前方路況、規劃頁沿途路況
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# 中央氣象署開放資料平臺授權碼（opendata.cwa.gov.tw → 取得授權碼）：前方降雨、規劃頁沿途天氣
CWA_API_KEY=
